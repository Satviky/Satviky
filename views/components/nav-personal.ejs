
<style>
  #hud-icon.open .line:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  #hud-icon.open .line:nth-child(2) {
    opacity: 0;
  }
  #hud-icon.open .line:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
  #nav-links.open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
</style>

<nav class="bg-[#0f0114]/10 sticky top-0 backdrop-blur text-gray-300 px-6 py-3 flex items-center justify-between border-b border-white/10 z-10">

  
  <!-- Brand -->
  <div class="text-lg font-semibold tracking-wide">
    Satviky
  </div>

  <!-- Mobile toggle -->
  <button
  onclick="toggleNav()"
  aria-label="Toggle navigation"
  class=" md:hidden w-10 h-10 flex items-center justify-center rounded-lg bg-white/10 hover:bg-white/20 active:bg-white/30 transition-all duration-150 relative
  "
>
  <svg width="512" height="512" viewBox="0 0 512 512" fill="black" xmlns="http://www.w3.org/2000/svg">
  <circle cx="80" cy="128" r="40" fill="white"/>
  <rect x="176" y="104" width="272" height="48" rx="24" fill="white"/>
  
  <circle cx="80" cy="256" r="40" fill="white"/>
  <rect x="176" y="232" width="272" height="48" rx="24" fill="white"/>
  
  <circle cx="80" cy="384" r="40" fill="white"/>
  <rect x="176" y="360" width="272" height="48" rx="24" fill="white"/>
</svg>
</button>


  <!-- Links -->
  <ul
    id="nav-links"
    class=" hidden md:flex gap-8 absolute md:static top-full left-0 w-full md:w-auto bg-black md:bg-transparent px-6 py-4 md:p-0
    "
  >
    <% const link = (key) => active === key
      ? 'text-amber-400 after:w-full'
      : 'hover:text-white after:w-0 hover:after:w-full'
    %>


    <li>
  <a
    href="/"
    class="
      relative
      px-4 py-2
      rounded-md
      text-sm tracking-wide

      transition-all duration-200

      <%= active === 'home'
        ? 'bg-white/10 text-amber-400 shadow-[0_0_12px_rgba(251,191,36,0.35)]'
        : 'text-gray-300 hover:bg-white/5 hover:text-white'
      %>
    "
  >
    Home
  </a>
</li>



    <li>
      <a href="/cv"
        class=" relative px-4 py-2 rounded-md text-sm tracking-wide transition-all duration-200 <%= active === 'cv'
                ? ` bg-white/10 text-amber-400 shadow-[0_0_12px_rgba(251,191,36,0.35)]`
                : ` bg-white/[0.03] text-gray-400 border border-white/[0.08] hover:bg-white/[0.07] hover:text-white`
            %>">
        CV
      </a>
    </li>

    <li>
        <a
            href="/projects"
            class=" relative px-4 py-2 rounded-md text-sm tracking-wide transition-all duration-200 <%= active === 'projects'
                ? ` bg-white/10 text-amber-400 shadow-[0_0_12px_rgba(251,191,36,0.35)]`
                : ` bg-white/[0.03] text-gray-400 border border-white/[0.08] hover:bg-white/[0.07] hover:text-white`
            %>">
            Missions
        </a>
    </li>


    <li>
      <a href="/app"
        class=" relative px-4 py-2 rounded-md text-sm tracking-wide transition-all duration-200 <%= active === 'app'
                ? ` bg-white/10 text-amber-400 shadow-[0_0_12px_rgba(251,191,36,0.35)]`
                : ` bg-white/[0.03] text-gray-400 border border-white/[0.08] hover:bg-white/[0.07] hover:text-white`
            %>">
        Apps
      </a>
    </li>

    <li>
      <a href="/contact"
        class=" relative px-4 py-2 rounded-md text-sm tracking-wide transition-all duration-200 <%= active === 'contact'
                ? ` bg-white/10 text-amber-400 shadow-[0_0_12px_rgba(251,191,36,0.35)]`
                : ` bg-white/[0.03] text-gray-400 border border-white/[0.08] hover:bg-white/[0.07] hover:text-white`
            %>">
        Contact
      </a>
    </li>
  </ul>
</nav>

<script>
  function toggleNav() {
    const nav = document.getElementById('nav-links')
    if (!nav) return
    nav.classList.toggle('hidden')
  }
</script>

