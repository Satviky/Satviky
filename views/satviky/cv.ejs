<style>
    .card {
        position: relative;
        width: 280px;
        /* FIX: prevent stretching */
        height: 300px;
        perspective: 1000px;
    }

    .card-inner {
        width: 100%;
        height: 100%;
        position: relative;
        transform-style: preserve-3d;
        transition: transform 1.5s ease;
    }

    .card-face {
        position: absolute;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
        border-radius: 12px;
        overflow: hidden;
    }

    .card-front {
        transform: rotateY(0);
        display: flex;
        flex-direction: column;
    }

    .card-back {
        transform: rotateY(180deg);
    }

    .card.revealed .card-inner {
        transform: rotateY(180deg);
    }
</style>


