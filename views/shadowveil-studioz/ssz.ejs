<script>
    const particles = document.getElementById("particles");

    if (particles) {

        for (let i = 0; i < 25; i++) {

            const p = document.createElement("div");

            p.className = "absolute w-[4px] h-[4px] bg-cyan-300 rounded-full opacity-60";

            p.style.left = Math.random() * 100 + "%";
            p.style.bottom = "-10px";

            p.style.animation = `float ${10 + Math.random() * 15}s linear infinite`;

            particles.appendChild(p);

        }

    }
</script>