<main class="sayori-home">

  <section
    class="sayori-hero relative overflow-hidden flex items-center min-h-[75vh] w-[calc(100%-40px)] max-w-[1180px] mx-auto py-28 max-md:min-h-auto max-md:py-20">
    <div class="hero-moon" aria-hidden="true"></div>

    <div class="hero-content">
      <p class="hero-eyebrow">A Discord game bot by Shadowveil Studioz</p>

      <h1>
        Games are better
        <span>when played on Sayori.</span>
      </h1>
      <!-- This is how h1 is supposed to look in the Website, but i feel it's a little long. -->

      <p class="hero-description">
        Play social deduction games, word games, trivia, competitive Tea games,
        and more with your Discord community.
      </p>

      <div class="hero-actions flex flex-wrap gap-4 mt-8">
        <a href="#browse-games" class="sayori-btn sayori-btn-primary">
          Explore Games
        </a>

        <a href="?explore" class="sayori-btn sayori-btn-secondary">
          Command Explorer
          <kbd>Ctrl K</kbd>
        </a>
      </div>
    </div>
    <div class="hero-mark" aria-hidden="true">
      <span>S</span>
    </div>
  </section>


  <!-- WEEKLY SPOTLIGHT; hardcoding for now but I have a good idea to be used later-->
  <section class="sayori-section spotlight-section">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Weekly Spotlight</p>
        <h2>Something worth playing tonight.</h2>
      </div>
      <span class="section-date">This week's pick</span>
    </div>

    <article class="spotlight-card">
      <div class="spotlight-content">
        <span class="game-label">Social Deduction</span>
        <h3>Mafia</h3>
        <p>
          Hidden roles. Quiet suspicions. One village trying to survive the night.
        </p>
        <div class="spotlight-actions">
          <a href="/shadowveil-studioz/sayori/socialdeduction#mafia">
            Discover Mafia
          </a>
          <button class="copy-command" data-command="/mafia" type="button">
            <span class="copy-command-text">/mafia ⧉</span>
            <span class="copy-command-status" aria-live="polite"></span>
          </button>
        </div>
      </div>

      <div class="spotlight-symbol" aria-hidden="true">
        🌛
      </div>

    </article>
  </section>


  <!-- FEATURED GAMES cuz why not?-->
  <section class="sayori-section">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Featured Games</p>
        <h2>Some games deserve the stage.</h2>
      </div>
    </div>
    <div class="featured-placeholder">
      <p>Featured game slider goes here which I don't know how to make.</p>
    </div>
  </section>


  <!-- TRENDING on Sayori.-->
  <section class="sayori-section">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Trending Across Sayori</p>
        <h2>Games communities keep coming back to.</h2>
      </div>
    </div>
    <div class="game-grid grid grid-cols-1 md:grid-cols-3 gap-4">
      <article class="game-card">
        <span class="game-label">Word Game</span>
        <h3>GuessWord</h3>
        <p>Use hints, think quickly, and uncover the hidden word.</p>
      </article>
      <article class="game-card">
        <span class="game-label">Social Deduction</span>
        <h3>Guess the Agent</h3>
        <p>Describe your word carefully. Someone among you is pretending.</p>
      </article>
      <article class="game-card">
        <span class="game-label">Guessing Game</span>
        <h3>GuessTime</h3>
        <p>Guess the hidden number before someone else gets there first.</p>
      </article>
    </div>
  </section>


  <!-- LEGACY yk the OGs-->
  <section class="sayori-section legacy-section">
    <div class="section-heading">
      <div>
        <p class="section-kicker">The Originals</p>
        <h2>Legacy Games</h2>
      </div>
      <span class="section-date">EST. NOV 2025</span>
    </div>
    <div class="game-grid">
      Should I make grid here or slider?
    </div>
  </section>


  <!-- EMERGING -->
  <section class="sayori-section">
    <div class="section-heading">
      <div>
        <p class="section-kicker">New Arrivals</p>
        <h2>Emerging Games</h2>
      </div>
    </div>
    <div class="emerging-grid count-1">
      <article class="game-card emerging-card">
        <span class="game-label">New Arrival</span>
        <h3>Wordchain</h3>
        <p>
          Continue the chain, think quickly, and don't be the player who breaks it.
          <br>
          Do not get started on 'y' attack! That's the stategy.
        </p>
      </article>
      <article class="game-card emerging-card">
        <span class="game-label">New Arrival</span>
        <h3>FAM</h3>
        <p>
          Vote for the answer everyone else is voting for. <br> If you fail to match the side everyone else is voting for, then get ready to be redzoned.
        </p>
      </article>
    </div>
  </section>


  <!-- BROWSE -->
  <section class="sayori-section browse-section" id="browse-games">
    <div class="section-heading">
      <div>
        <p class="section-kicker">The Collection</p>
        <h2>Explore by Category</h2>
      </div>
    </div>
    <div class="category-grid">
      <a href="/shadowveil-studioz/sayori/socialdeduction" class="category-card">
        <span>01</span>
        <h3>Social Deduction</h3>
        <p>Deception, hidden roles, discussion, deduction, and voting.</p>
      </a>
      <a href="/shadowveil-studioz/sayori/word-games" class="category-card">
        <span>02</span>
        <h3>Word Games</h3>
        <p>Words, vocabulary, speed, chains, clues, and creative thinking.</p>
      </a>
      <a href="/shadowveil-studioz/sayori/tea-games" class="category-card">
        <span>03</span>
        <h3>Tea Games</h3>
        <p>Competitive multiplayer games built around speed and knowledge.</p>
      </a>
      <a href="/shadowveil-studioz/sayori/trivia-games" class="category-card">
        <span>04</span>
        <h3>Trivia</h3>
        <p>Questions, knowledge, categories, and challenges.</p>
      </a>
      <a href="/shadowveil-studioz/sayori/guess-games" class="category-card">
        <span>05</span>
        <h3>Guess</h3>
        <p>Secret numbers, words, hints, instict and race.</p>
      </a>
      <a href="/shadowveil-studioz/sayori/simplefun" class="category-card">
        <span>06</span>
        <h3>Simple Fun</h3>
        <p>Casual, two player, multiplayer and fast paced.</p>
      </a>
    </div>
  </section>


  <!-- EXPLORER CTA -->
  <section class="explorer-cta">
    <p class="section-kicker">Know what you're looking for?</p>
    <h2>Every game. Every command. One search.</h2>
    <p>
      Search Sayori's games, commands, aliases, and categories from the
      Gamebook.
    </p>
    <a href="?explore" class="sayori-btn sayori-btn-primary">
      Open Gamebook
      <kbd>Ctrl K</kbd>
    </a>
  </section>
</main>

