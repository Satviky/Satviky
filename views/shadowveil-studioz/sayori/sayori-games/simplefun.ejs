<main class="sayori-home">
    <section class="sayori-section pt-16 lg:pt-24">
        <div class="max-w-[1180px] mx-auto px-5 text-center">
            <p class="hero-eyebrow">
                CATEGORY
            </p>
            <h1 class="font-serif text-[clamp(3rem,8vw,5.5rem)] leading-[0.92] mt-4">
                Simple
                <span class="text-[var(--sayori-lavender-bright)]">
                    Fun
                </span>
            </h1>
            <p class="hero-description mt-6 max-w-2xl mx-auto">
                Some games require strategy.
                Some require teamwork.
                And some exist because they sounded fun at 2 AM.
                Pick how many people are playing and we'll do the rest.
            </p>
        </div>
    </section>
    <section class="max-w-[1180px] mx-auto px-5 mt-16">
        <div class="grid gap-6 lg:grid-cols-3">

            <a
                href="/shadowveil-studioz/sayori/simplefun/single-player"
                class=" block rounded-3xl border border-[var(--sayori-border)] bg-[var(--sayori-surface)] p-8 transition duration-200 hover:-translate-y-2 hover:border-[var(--sayori-lavender)]">
                <div class="text-5xl">
                    👤
                </div>
                <h2 class="font-serif text-3xl mt-6">
                    Single Player
                </h2>
                <p class="text-[var(--sayori-muted)] leading-8 mt-4">
                    No teammates.
                    No enemies.
                    No one to blame except yourself.
                </p>
                <div class="mt-8 flex justify-between items-center">
                    <span class="text-sm text-[var(--sayori-orange)]">
                        2 Games
                    </span>
                    <span class="sayori-btn">
                        Browse →
                    </span>
                </div>
            </a>
            <a
                href="/shadowveil-studioz/sayori/simplefun/two-player"
                class=" block rounded-3xl border border-[var(--sayori-border)] bg-[var(--sayori-surface)] p-8 transition duration-200 hover:-translate-y-2 hover:border-[var(--sayori-lavender)] ">
                <div class="text-5xl">
                    👥
                </div>
                <h2 class="font-serif text-3xl mt-6">
                    Two Player
                </h2>
                <p class="text-[var(--sayori-muted)] leading-8 mt-4">
                    Bring a friend.
                    Or someone you no longer wish to call your friend.
                </p>
                <div class="mt-8 flex justify-between items-center">
                    <span class="text-sm text-[var(--sayori-orange)]">
                        5 Games
                    </span>
                    <span class="sayori-btn">
                        Browse →
                    </span>
                </div>
            </a>

            <a
                href="/shadowveil-studioz/sayori/simplefun/multiplayer"
                class=" block rounded-3xl border border-[var(--sayori-border)] bg-[var(--sayori-surface)] p-8 transition duration-200 hover:-translate-y-2 hover:border-[var(--sayori-lavender)] ">
                <div class="text-5xl">
                    👨‍👩‍👧‍👦
                </div>
                <h2 class="font-serif text-3xl mt-6">
                    Multiplayer
                </h2>
                <p class="text-[var(--sayori-muted)] leading-8 mt-4">
                    Things become significantly more chaotic once more people join.
                    That's half the fun.
                </p>
                <div class="mt-8 flex justify-between items-center">
                    <span class="text-sm text-[var(--sayori-orange)]">
                        2 Games
                    </span>
                    <span class="sayori-btn">
                        Browse →
                    </span>
                </div>
            </a>
        </div>
    </section>
    <section class="max-w-[1180px] mx-auto px-5 mt-20">
        <div
            class=" rounded-3xl border border-dashed border-[var(--sayori-border)] bg-[var(--sayori-raised)] p-10 text-center ">
            <h2 class="font-serif text-4xl">
                Can't Decide?
            </h2>
            <p class="hero-description mt-5 max-w-2xl mx-auto">
                Press
                <span class="rounded-md border px-2 py-1 text-sm">
                    Ctrl
                </span>
                +
                <span class="rounded-md border px-2 py-1 text-sm">
                    K
                </span>
                to open the Gamebook and search every game available in Sayori.
            </p>
            <a
                href="?explore"
                class="sayori-btn mt-8">
                📖 Open Gamebook
            </a>
        </div>
    </section>
</main>