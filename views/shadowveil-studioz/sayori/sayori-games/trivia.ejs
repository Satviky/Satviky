        <div class="min-h-[3px]"></div>
        <section id="math" class="game-card rounded-3xl overflow-hidden bg-[#731010] border border-[var(--sayori-border)]">
            <header class="card-header px-8 py-12">
                <div class="card-symbol">
                    🔢
                </div>
                <h2 class="text-2xl text-[var(--sayori-lavender-bright)]">Math trivia</h2>
                <p class="card-tagline">
                    Your friend circle consist of people who are literally walking calculator? Make them fight to win the game, and enjoy the chaos.
                </p>
            </header>

            <div class="px-8 pb-8 space-y-10">
                <section>
                    <h3 class="flex items-center gap-2 text-xl font-semibold mb-4">🎮 How to Play</h3>
                    <p class="text-[var(--sayori-muted)] leading-8">
