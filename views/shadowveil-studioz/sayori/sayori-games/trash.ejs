    </div>


    <!-- Discord Widget -->
    <div class="container my-5" id="discord-widget" data-aos="fade-up">
        <div class="discord-card text-center p-4">
            <h3 id="server-name" class="discord-heading mb-2">Loading...</h3>
            <hr class="discord-divider">
            <p id="member-count" class="fs-5">Fetching online members...</p>
            <a id="discord-link" href="#" target="_blank" class="discord-btn mt-3">
                🚀 Join Our Discord
            </a>
            <!-- <a id="link" href="https://discord.gg/CAzPpWJfmS" class="hidden">
        🚀 Join Our Discord
      </a> -->
            <div class="particle-bg"></div>
        </div>
    </div>

    <script>
        async function loadDiscordWidget() {
            try {
                const res = await fetch("https://discord.com/api/guilds/989942565908389908/widget.json");
                const data = await res.json();

                document.getElementById("server-name").textContent = data.name;

                animateCount("member-count", data.presence_count);
                document.getElementById("discord-link").href = data.instant_invite;
            } catch (err) {
                document.getElementById("server-name").textContent = "Server unavailable";
                document.getElementById("member-count").textContent = "Try again later.";
            }
        }

        function animateCount(id, target) {
            let el = document.getElementById(id);
            let current = 0;
            let increment = Math.ceil(target / 60);
            let interval = setInterval(() => {
                current += increment;
                if (current >= target) {
                    current = target;
                    clearInterval(interval);
                }
                el.textContent = `${current} online members ✨`;
            }, 16);
        }

        // Initial load
        loadDiscordWidget();

        // Auto-refresh every 30s
        setInterval(loadDiscordWidget, 30000);
    </script>


    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700&display=swap" rel="stylesheet">



    <!-- Footer -->
    <footer class="text-center p-3 mt-5">
        &copy; <%= new Date().getFullYear() %> Sayori Bot - A Shadowveil Studioz Project.
