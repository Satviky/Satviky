<main class="py-24">
    <header class="text-center py-5">
        <h1 class="display-4 text-[var(--sayori-lavender)]">Sayori - Privacy Policy</h1>
        <p class="lead text-[var(--sayori-orange)]">Effective Date:- 11/09/2025 [DD/MM/YYYY]</p>
        <p class="lead text-[var(--sayori-orange-soft)]">Bot's Name: Sayori</p>
