<script>
    const joinTexts = ["Join the Chaos →", "Come Say Hi →", "Proceed at Your Own Risk →", "Become Part of the Lore →", "Definitely No Bugs Here →", "One More Member Won't Hurt →", "Join Before Sayori Finds You →", "Welcome to the Asylum →"];
    document.getElementById("join-btn").textContent = joinTexts[Math.floor(Math.random() * joinTexts.length)];

    function animateCounter(id, end) { const e = document.getElementById(id); let n = 0; const i = Math.max(1, Math.ceil(end / 40)); const t = setInterval(() => { n += i; if (n >= end) { n = end; clearInterval(t) } e.textContent = n }, 20) }

    fetch("https://discord.com/api/guilds/989942565908389908/widget.json").then(r => r.json()).then(data => {
        document.getElementById("server-name").textContent = data.name;
        document.getElementById("join-btn").href = data.instant_invite;
        animateCounter("online-count", data.presence_count);

        const c = document.getElementById("online-users");
        c.innerHTML = "";
        data.members.slice(0, 8).forEach(m => {
            const img = document.createElement("img");
            img.src = m.avatar_url;
            img.title = m.username;
            img.className = "online-avatar";
            c.appendChild(img);
        });

        if (data.members.length > 8) {
            const more = document.createElement("div");
            more.className = "w-11 h-11 rounded-full bg-[#2b2542] flex items-center justify-center text-sm ml-2";
            more.textContent = `+${data.members.length - 8}`;
            c.appendChild(more);
        }
    });
</script>